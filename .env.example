# Vestige environment variables (all optional — defaults work out of the box)

# Database path (default: ~/.vestige/vestige.db)
# VESTIGE_DB_PATH=/path/to/vestige.db

# Dashboard HTTP port (default: 3927)
# VESTIGE_DASHBOARD_PORT=3927

# Auto-consolidation interval in hours (default: 6)
# VESTIGE_CONSOLIDATION_INTERVAL_HOURS=6

# Rust logging filter (default: info)
# RUST_LOG=vestige_mcp=debug,vestige_core=debug

# --- HTTP MCP transport (off by default, stdio is the production path) ---
# Bind address for the streamable HTTP MCP server. Default 127.0.0.1.
# IMPORTANT: any non-loopback value exposes the MCP surface on the network;
# only set this if you fully understand the threat model and have TLS +
# reverse-proxy + per-IP rate limiting in front of it.
# VESTIGE_HTTP_BIND=127.0.0.1:8723
#
# Bearer token used for HTTP MCP auth. Persisted to disk (0600) on first
# run and printed (prefix-only) to stderr at startup. Rotate by deleting
# the file and restarting.
# VESTIGE_AUTH_TOKEN=

# --- OpenTelemetry / OTLP (opt-in, requires --features telemetry build) ---
# OTLP gRPC/HTTP endpoint for traces and metrics. Either var works; the
# VESTIGE_-prefixed one wins if both are set so the dashboard build can
# point at a project-specific collector without disturbing global OTEL
# defaults the agent might pick up from the shell.
# VESTIGE_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- At-rest encryption (opt-in, requires SQLCipher build) ---
# Master key for SQLCipher. Without this, the SQLite file on disk is
# plaintext — fine for local-only deployments, NOT fine for shared hosts.
# VESTIGE_ENCRYPTION_KEY=

# --- Test-only ---
# Use mock embeddings in tests (skips 200MB ONNX model download)
# VESTIGE_TEST_MOCK_EMBEDDINGS=1
