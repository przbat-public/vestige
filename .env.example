# Vestige environment variables (all optional — defaults work out of the box)

# Database path — deliberately NOT an environment variable: the location comes
# from the `directories` crate (`ProjectDirs::from("com", "vestige", "core")`) —
# macOS ~/Library/Application Support/com.vestige.core/vestige.db,
# Linux ~/.local/share/core/vestige.db (or $XDG_DATA_HOME/core/),
# Windows %APPDATA%\vestige\core\data\vestige.db. Override it by launching
# vestige-mcp with `--data-dir <PATH>`. See docs/STORAGE.md.

# Dashboard HTTP port (default: 3927)
# VESTIGE_DASHBOARD_PORT=3927

# Auto-consolidation interval in hours (default: 6)
# VESTIGE_CONSOLIDATION_INTERVAL_HOURS=6

# Rust logging filter (default: info)
# RUST_LOG=vestige_mcp=debug,vestige_core=debug

# --- HTTP MCP transport (off by default, stdio is the production path) ---
# Bind address for the streamable HTTP MCP server. Default 127.0.0.1.
# IMPORTANT: any non-loopback value exposes the MCP surface on the network;
# only set this if you fully understand the threat model and have TLS +
# reverse-proxy + per-IP rate limiting in front of it.
# VESTIGE_HTTP_BIND=127.0.0.1:8723
#
# Bearer token used for HTTP MCP auth. Persisted to disk (0600) on first
# run and printed (prefix-only) to stderr at startup. Rotate by deleting
# the file and restarting.
# VESTIGE_AUTH_TOKEN=

# --- OpenTelemetry / OTLP (opt-in, requires --features telemetry build) ---
# OTLP gRPC/HTTP endpoint for traces and metrics. Either var works; the
# VESTIGE_-prefixed one wins if both are set so the dashboard build can
# point at a project-specific collector without disturbing global OTEL
# defaults the agent might pick up from the shell.
# VESTIGE_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- At-rest encryption (opt-in, requires SQLCipher build) ---
# Master key for SQLCipher. Without this, the SQLite file on disk is
# plaintext — fine for local-only deployments, NOT fine for shared hosts.
# VESTIGE_ENCRYPTION_KEY=

# --- Nomic task prefixes (DEFAULT ON, opt-out) ---
# nomic-embed-text-v1.5 is an asymmetric bi-encoder: its model card says the
# prompt MUST carry a task-instruction prefix (`search_document:` for stored
# content, `search_query:` for queries) and fastembed does not add one. Vestige
# therefore applies them by default — the raw (prefix-less) regime is off-label.
#
# DEFAULT: on. Unset, or set to `1`/`true`/`yes`/`on`, keeps prefixes on. Any
# other value (`0`/`false`/`no`/`off`) selects the legacy raw regime.
#
# COUPLED OPERATION either way: changing this flips the embedding space.
# Vectors already stored were built in the other regime and are NOT comparable
# to new query embeddings. After changing it, run the `regenerate_embeddings`
# MCP tool with `force: true` to re-embed the whole store, or retrieval will be
# inconsistent. The per-memory `embedding_model` tag records the regime
# (`nomic-embed-text-v1.5+v2+prefix` vs `...+v2`) so an un-migrated store is
# identifiable (see AGENTS.md, embedding space version).
# VESTIGE_NOMIC_PREFIXES=0

# --- Retrieval tuning (opt-in, measure on the LoCoMo harness before adopting) ---
# MMR diversity reordering of search results. Helps multi-hop questions whose
# failure mode is "K near-duplicate hits about one fact" by forcing the context
# window to cover DIFFERENT facts. Lambda is the relevance/diversity trade-off.
# VESTIGE_MMR=on
# VESTIGE_MMR_LAMBDA=0.7
#
# ColBERT late-interaction reranker (token-level MaxSim) in place of the Jina
# cross-encoder. Requires a build with `--features late-interaction` AND a model
# directory (colbert-ir/colbertv2.0: model.onnx + tokenizer.json). If the model
# is missing/unreadable, search silently falls back to the Jina cross-encoder.
# VESTIGE_LATE_INTERACTION=on
# VESTIGE_COLBERT_MODEL_DIR=/path/to/colbertv2.0

# --- Test-only ---
# Deterministic, offline embedder: replaces the ONNX forward pass with a hash of
# the text (same 384 dims, L2-normalised). Read by
# vestige_core::embeddings::mock_embeddings_enabled; lets the test suite exercise
# the semantic path without downloading the ~547 MB model, and it is what CI
# sets for every job.
# VESTIGE_TEST_MOCK_EMBEDDINGS=1
